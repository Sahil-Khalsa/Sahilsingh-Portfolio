# Copy this file to .env.local and fill in your values

# Your deployed site URL (used for sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://sahilsingh.dev

# EmailJS — sign up at https://www.emailjs.com/
# Dashboard → Email Services → Service ID
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
# Dashboard → Email Templates → Template ID
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
# Dashboard → Account → Public Key
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key
